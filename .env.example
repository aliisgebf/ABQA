# ==============================================================================
# ABAQ | عَبَق — Environment Configuration (.env)
# Store private keys in Google AI Studio Settings > Secrets
# Never commit real credentials or expose secret keys in browser bundles!
# ==============================================================================

# SUPABASE_URL: Your Supabase project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_PUBLISHABLE_KEY: Supabase Anon / Publishable API Key (safe for public RLS queries)
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."

# SUPABASE_SECRET_KEY: Optional Server-Side Service Role Key (NEVER exposed to frontend!)
SUPABASE_SECRET_KEY=""

# ADMIN_PASSWORD_HASH or ADMIN_SECRET: Secret for initial administrator access
ADMIN_SECRET_KEY="abaq_admin_secret_passphrase_change_in_production"

# STORE_WHATSAPP: Customer checkout routing number (default: +967718488431)
STORE_WHATSAPP="+967718488431"

# PORT: Local development server port (AI Studio default: 3000)
PORT=3000
